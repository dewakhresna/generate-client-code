# ============================================================
# KONFIGURASI LINGKUNGAN (ENVIRONMENT VARIABLES EXAMPLE)
# Rename file ini dari '.env.example' menjadi '.env' dan isi dengan data yang valid
# ============================================================

# ID Spreadsheet Google Sheets Anda (ganti dengan ID asli di file .env lokal)
DEFAULT_SPREADSHEET_ID=masukkan_spreadsheet_id_disini

# Nama Sheet di dalam Google Sheets
DEFAULT_SHEET_NAME=NamaSheetUtama
